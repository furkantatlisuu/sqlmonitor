<?xml version="1.0" encoding="utf-8"?>
<!--
  Visual Studio'da sağ tık > Publish ile kullanılan profil.

  Ayarlar README'deki "EXE olarak yayınla" komutuyla BİREBİR aynı olacak
  şekilde seçildi - VS'ten yayınlayan da komut satırından yayınlayan da
  aynı çıktıyı alsın:

    - SelfContained    : hedef makinede .NET kurulu OLMASA da çalışır
    - PublishSingleFile: tüm DLL'ler tek exe'nin içinde (wwwroot ve
                         appsettings.json yanında ayrı dosya kalır -
                         biri düzenlenebilir olmalı, diğeri statik içerik)
    - PublishUrl       : proje klasörünün DIŞINA (..\SqlMonitor-exe) -
                         yayın çıktısı depoya/zip'e yanlışlıkla karışmasın
-->
<Project>
  <PropertyGroup>
    <WebPublishMethod>FileSystem</WebPublishMethod>
    <PublishProvider>FileSystem</PublishProvider>
    <_TargetId>Folder</_TargetId>

    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net8.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishReadyToRun>false</PublishReadyToRun>

    <!-- PublishUrl'ü Visual Studio, PublishDir'i "dotnet publish" okur -
         ikisi aynı olmazsa aynı profil iki farklı yere yayınlar. -->
    <PublishUrl>..\SqlMonitor-exe\</PublishUrl>
    <PublishDir>..\SqlMonitor-exe\</PublishDir>
    <DeleteExistingFiles>true</DeleteExistingFiles>
    <ExcludeApp_Data>false</ExcludeApp_Data>
    <LaunchSiteAfterPublish>false</LaunchSiteAfterPublish>
  </PropertyGroup>
</Project>
