<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SqlMonitor</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>

    <!--
      Pencereli uygulama: çift tıklanınca ARKA PLANDA açılır, konsol
      penceresi görünmez (kullanıcı isteği). Bunun bedeli, konsola yazılan
      her şeyin kaybolmasıdır - o yüzden günlük dosyaya yazılıyor
      (Infrastructure/FileLogger.cs) ve açılış hataları pencerede
      gösteriliyor (Infrastructure/StartupFailureDialog.cs). İkisi
      olmadan WinExe'ye geçmek, hataları sessizce yutmak demek olurdu.

      Durdurmak için: Görev Yöneticisi > SqlMonitor.exe. Sürekli açık
      kalması gerekiyorsa Windows Service olarak kurmak daha doğru.
    -->
    <OutputType>WinExe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.35" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
    <PackageReference Include="Npgsql" Version="8.0.5" />
  </ItemGroup>

  <!--
    appsettings.Local.json YEREL sırlar içindir (Slack webhook'u gibi) ve
    .gitignore'dadır. Publish çıktısına DA girmemeli: yayınlanan klasör
    çoğu zaman birine gönderilir/zip'lenir, sır oraya sızmamalı.
    Geliştirirken yine okunuyor (dosya proje kökünde durduğu sürece);
    yalnızca "yayınlanan pakete kopyalama" davranışı kapatıldı.
    EXE'de de Slack isteniyorsa dosya exe'nin yanına ELLE konur.
  -->
  <ItemGroup>
    <Content Update="appsettings.Local.json" CopyToPublishDirectory="Never" />
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <!-- Dağıtılan pakette hata ayıklama sembollerine (.pdb) gerek yok. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <!--
    YAYIN (publish) ayarları. Yalnızca `dotnet publish` sırasında
    devreye girer (_IsPublishing) - Visual Studio'dan F5 ile çalıştırma
    etkilenmez, orada eskisi gibi hızlı ve RID'siz derlenir.

    Buradaki amaç: karşı tarafta .NET KURULU OLMASIN, klasörde yüzlerce
    DLL DURMASIN. Çıktı tek bir SqlMonitor.exe + yanında wwwroot olur.
    wwwroot tek dosyaya gömülemez (statik dosyalar diskten servis
    ediliyor); exe'yi wwwroot'suz taşımak "/" adresinde 404 verir.

    Bu ayarlar bilerek csproj'da: komut satırına yazılan bir bayrak
    unutulur, bir dahaki yayın sessizce 400 dosyalık klasör üretirdi.
  -->
  <PropertyGroup Condition="'$(_IsPublishing)' == 'true'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- SqlClient'ın 10 dilde hata mesajı klasörü; bize gereksiz. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

</Project>
